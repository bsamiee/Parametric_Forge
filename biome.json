{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!flake.lock",
            "!pnpm-lock.yaml",
            "!overlays/_sources/generated.json",
            "!**/.artifacts",
            "!**/.venv",
            "!**/.archive",
            "!**/_archive",
            "!**/scratch",
            "!**/.scratch",
            "!**/_tmp",
            "!**/.tmp",
            "!**/.cache",
            "!**/.history",
            "!**/*.html"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 150
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "json": {
        "parser": {
            "allowComments": true
        }
    }
}
