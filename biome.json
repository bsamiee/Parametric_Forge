{
    "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!flake.lock",
            "!pnpm-lock.yaml",
            "!overlays/_sources/generated.json",
            "!node_modules",
            "!**/__pycache__",
            "!**/.artifacts",
            "!**/.direnv",
            "!**/.venv",
            "!**/.archive",
            "!**/_archive",
            "!**/scratch",
            "!**/.scratch",
            "!**/_tmp",
            "!**/.tmp",
            "!**/.cache",
            "!**/.history",
            "!**/*.html"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 150
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "json": {
        "parser": {
            "allowComments": true
        }
    },
    "overrides": [
        {
            "includes": [".claude/skills/coding-applescript/{examples,templates}/**"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": "off"
                    },
                    "suspicious": {
                        "noRedundantUseStrict": "off"
                    }
                }
            }
        }
    ],
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
