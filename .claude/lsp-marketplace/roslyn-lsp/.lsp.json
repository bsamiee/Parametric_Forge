{
    "roslyn": {
        "command": "Microsoft.CodeAnalysis.LanguageServer",
        "args": [
            "--stdio",
            "--autoLoadProjects",
            "--logLevel",
            "Information",
            "--extensionLogDirectory",
            "/Users/bardiasamiee/.local/state/roslyn-ls"
