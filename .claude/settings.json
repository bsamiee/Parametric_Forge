{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "effortLevel": "high",
    "skillOverrides": {
        "heptabase-cli": "name-only",
        "rhino-mcp": "name-only"
    },
    "claudeMdExcludes": [
        "**/.cache/**/CLAUDE.md",
        "**/node_modules/**/CLAUDE.md",
        "**/bin/**/CLAUDE.md",
        "**/obj/**/CLAUDE.md",
        "**/.artifacts/**/CLAUDE.md"
    ],
    "permissions": {
        "allow": ["Bash(container run *)", "Bash(docker run *)"],
        "deny": []
    }
}
