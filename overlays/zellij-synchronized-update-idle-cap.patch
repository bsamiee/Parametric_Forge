+const SYNCHRONIZED_UPDATE_IDLE_CAP: std::time::Duration = std::time::Duration::from_secs(1);
+const SYNCHRONIZED_UPDATE_CAP: std::time::Duration = std::time::Duration::from_secs(2);
 
