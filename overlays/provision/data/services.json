[
    {
        "service": "timescale",
        "role": "time",
        "profile": "timescale",
        "enabledEnv": "",
        "enabledDefault": "1",
        "imageEnv": "PROVISION_TIMESCALE_IMAGE",
        "imageDefault": "timescale/timescaledb-ha:pg18.4-ts2.28.2-all",
        "portEnv": "PROVISION_TIMESCALE_PORT",
        "portDefault": "15432",
        "dsnEnv": "PROVISION_TIMESCALE_DSN",
        "volumeMount": "/home/postgres/pgdata/data",
        "preload": "timescaledb",
        "containerPort": 5432,
        "host": "127.0.0.1",
        "databaseName": "app",
        "databaseUser": "postgres"
    },
    {
        "service": "search",
        "role": "search",
        "profile": "pg_search",
        "enabledEnv": "",
        "enabledDefault": "1",
        "imageEnv": "PROVISION_SEARCH_IMAGE",
        "imageDefault": "paradedb/paradedb:0.24.1-pg18",
        "portEnv": "PROVISION_SEARCH_PORT",
        "portDefault": "15433",
        "dsnEnv": "PROVISION_SEARCH_DSN",
        "volumeMount": "/var/lib/postgresql",
        "preload": "pg_search,pg_cron",
        "containerPort": 5432,
        "host": "127.0.0.1",
        "databaseName": "app",
        "databaseUser": "postgres"
    },
    {
        "service": "pgduckdb",
        "role": "analytics",
        "profile": "analytics-probe",
        "enabledEnv": "PROVISION_PGDUCKDB",
        "enabledDefault": "0",
        "imageEnv": "PROVISION_PGDUCKDB_IMAGE",
        "imageDefault": "pgduckdb/pgduckdb:18-v1.1.1",
        "portEnv": "PROVISION_PGDUCKDB_PORT",
        "portDefault": "15434",
        "dsnEnv": "PROVISION_PGDUCKDB_DSN",
        "volumeMount": "/var/lib/postgresql",
        "preload": "pg_duckdb",
        "containerPort": 5432,
        "host": "127.0.0.1",
        "databaseName": "app",
        "databaseUser": "postgres"
    }
]
