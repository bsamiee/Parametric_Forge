{
    // --- [EXPLORER_VISIBILITY] ---------------------------------------------------------
    "explorer.compactFolders": false,
    "files.exclude": {
        "**/.artifacts": true,
        "**/.cache": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/node_modules": true,
        "result": true,
        "result-*": true
    },

    // --- [FILE_WATCHING] ---------------------------------------------------------------
    "files.watcherExclude": {
        "**/.artifacts/**": true,
        "**/.cache/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/node_modules/**": true,
        "**/result/**": true,
        "**/result-*/**": true
    },

    // --- [FILE_NESTING] ----------------------------------------------------------------
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        ".gitignore": ".gitattributes",
        "flake.nix": ".mcp.json, flake.lock, mise.toml, nvfetcher.toml",
        "package.json": "biome.json, pnpm-lock.yaml, pnpm-workspace.yaml, tsconfig.json",
        "pyproject.toml": "uv.lock",
        "README.md": "LICENSE"
    },

    // --- [NIX] -------------------------------------------------------------------------
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nixd",
    "nix.serverSettings": {
        "nixd": {
            "formatting": { "command": ["alejandra"] },
            "nixpkgs": { "expr": "(builtins.getFlake (builtins.toString ./.)).darwinConfigurations.macbook.pkgs" },
            "options": {
                "nix-darwin": { "expr": "(builtins.getFlake (builtins.toString ./.)).darwinConfigurations.macbook.options" },
                "home-manager": {
                    "expr": "(builtins.getFlake (builtins.toString ./.)).darwinConfigurations.macbook.options.home-manager.users.type.getSubOptions []"
                }
            }
        }
    },
    "nix.formatterPath": "alejandra",
    "[nix]": { "editor.defaultFormatter": "jnoortheen.nix-ide" },

    // --- [LUA] -------------------------------------------------------------------------
    "[lua]": { "editor.defaultFormatter": "johnnymorganz.stylua" },

    // --- [PYTHON] ----------------------------------------------------------------------
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": false,
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "ty.experimental.useUv": "on",
    "ty.diagnosticMode": "workspace",
    "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },

    // --- [TYPESCRIPT] ------------------------------------------------------------------
    "js/ts.experimental.useTsgo": true,
    "js/ts.tsdk.path": "./node_modules/typescript",
    "[typescript][javascript][json][jsonc]": { "editor.defaultFormatter": "biomejs.biome" },

    // --- [YAML] ------------------------------------------------------------------------
    "yaml.format.enable": false,

    // --- [SHELL] -----------------------------------------------------------------------
    "[shellscript]": { "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode" },

    // --- [TOML] ------------------------------------------------------------------------
    "[toml]": { "editor.defaultFormatter": "tombi-toml.tombi" },

    // --- [MISE] ------------------------------------------------------------------------
    "mise.enableConfigDiagnostics": false
}
