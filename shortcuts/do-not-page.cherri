#define name Do Not Page
#define color purple
#define glyph bellSlash
#define inputs text
#define outputs text
#include 'actions/settings'

@request = "{ShortcutInput}"
if @request == "on" {
    DNDOn()
} else {
    if @request == "off" {
        DNDOff()
    } else {
        toggleDND()
    }
}
const focus = getFocusMode()
@state = "off"
@held = "{focus}"
if @held == "Do Not Disturb" {
    @state = "on"
}
mustOutput("{@state}", "Do not page: {@state}")
