#define name Agent Reply
#define color blue
#define glyph sendMessage
#define inputs text
#define outputs text
#include 'actions/web'
#include 'actions/text'
#include 'actions/storage'

const server = "https://ntfy.parametric-arsenal.cloud"
const token = getStoredValue("NTFY_BUTTON_TOKEN", true)

@request = "{ShortcutInput}"
@target = replaceText('\n[\s\S]*', "", @request, true, true)
@reply = replaceText('^[^\n]*\n?', "", @request, true, true)
if !@target {
    const sessions = downloadURL("{server}/sessions/json?poll=1&since=latest", {"Authorization": "Bearer {token}"})
    const newest = getDictionary(sessions)
    const panes = splitText("{newest['message']}", "\n")
    const pane = chooseFromList(panes, "Session")
    @target = replaceText(' [\s\S]*', "", "{pane}", true, true)
}
if !@reply {
    @reply = prompt("Reply to {@target}")
}
const sent = fileRequest("{server}/reply", "POST", @reply, {"Authorization": "Bearer {token}", "X-Title": "{@target}"})
const receipt = getDictionary(sent)
mustOutput("{receipt['id']}", "Sent to {@target}")
